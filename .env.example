# Copy to .env.local and fill in values in the Vercel dashboard or locally.
# Names only — never commit real secrets.

# Site
NEXT_PUBLIC_SITE_URL=

# Rankings (optional)
RAPIDAPI_KEY=
TENNIS_API_REVALIDATE_SECONDS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_LAUNCH_ANNUAL=
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_PLAYER_GUIDE=
STRIPE_COUPON_LAUNCH_MONTHLY=

# Player Guide downloads (optional; falls back to STRIPE_SECRET_KEY)
GUIDE_DOWNLOAD_SECRET=

# Courtside local preview (development only)
COURTSIDE_PREVIEW=

# Optional social embeds
NEXT_PUBLIC_X_POST_URLS=

# Account magic-link email (optional — without these, cookie-only access applies)
RESEND_API_KEY=
ACCOUNT_EMAIL_FROM=
ACCOUNT_MAGIC_LINK_SECRET=